{
  "name": "holo-goals",
  "version": "1.0.0",
  "description": "HOLO//GOALS 全息长期目标矩阵 — 长期目标 / 阶段项目 / 小目标三级管理 + 每日专注计时 + 自评进度 + 提醒 + 统计 + 拖拽排序",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.holo.goals",
    "productName": "HOLO-GOALS",
    "icon": "logo.ico",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "logo.ico"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "HOLO-GOALS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
